{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Instagram guarded publication config",
  "type": "object",
  "additionalProperties": false,
  "required": ["account_id", "expected_username", "api_host", "api_version", "media_kind", "media_path", "caption_path", "asset_url", "mode"],
  "properties": {
    "account_id": {"type": "string", "pattern": "^[0-9]+$"},
    "expected_username": {"type": "string", "minLength": 1},
    "api_host": {"enum": ["graph.facebook.com", "graph.instagram.com"]},
    "api_version": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
    "media_kind": {"enum": ["IMAGE", "REELS"]},
    "media_path": {"type": "string"},
    "caption_path": {"type": "string"},
    "cover_path": {"type": "string"},
    "asset_url": {"type": "string", "pattern": "^https://"},
    "cover_url": {"type": "string", "pattern": "^https://"},
    "mode": {"enum": ["NORMAL", "TRIAL"]},
    "trial_strategy": {"enum": ["MANUAL", "SS_PERFORMANCE"]},
    "share_to_feed": {"type": "boolean"},
    "is_ai_generated": {"type": "boolean"},
    "poll_interval_seconds": {"type": "integer", "minimum": 15, "maximum": 120},
    "poll_timeout_seconds": {"type": "integer", "minimum": 60, "maximum": 1800}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "TRIAL"}}},
      "then": {"required": ["trial_strategy"], "properties": {"media_kind": {"const": "REELS"}}}
    }
  ]
}
